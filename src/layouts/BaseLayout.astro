---
interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'ja';
}

const { title, description = 'Top Notch Inc. — International Business Advisory', lang = 'en' } = Astro.props;
const isJa = lang === 'ja';
const prefix = isJa ? '/ja' : '';
const switchLang = isJa ? '/' : '/ja/';
const switchLabel = isJa ? 'EN' : 'JA';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Top Notch Inc.</title>
  </head>
  <body>
    <header class="header">
      <nav class="container nav">
        <a href={`${prefix}/`} class="logo" aria-label="Top Notch Inc.">
          <img src="/images/topnotch_logo.jpg" alt="Top Notch Inc." class="logo-img" />
        </a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <ul class="nav-links" id="nav-links">
          <li><a href={`${prefix}/#about`}>{isJa ? '会社概要' : 'About'}</a></li>
          <li><a href={`${prefix}/#services`}>{isJa ? 'サービス' : 'Services'}</a></li>
          <li><a href={`${prefix}/#founder`}>{isJa ? '代表紹介' : 'Founder'}</a></li>
          <li><a href={`${prefix}/#partners`}>{isJa ? 'パートナー' : 'Partners'}</a></li>
          <li><a href={`${prefix}/blog`}>{isJa ? 'ブログ' : 'Blog'}</a></li>
          <li><a href={`${prefix}/#contact`} class="btn-nav">{isJa ? 'お問い合わせ' : 'Contact'}</a></li>
          <li><a href={switchLang} class="lang-switch">{switchLabel}</a></li>
        </ul>
      </nav>
    </header>

    <script>
      const toggle = document.querySelector('.nav-toggle');
      const navLinks = document.getElementById('nav-links');
      if (toggle && navLinks) {
        toggle.addEventListener('click', () => {
          const open = navLinks.classList.toggle('is-open');
          toggle.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
        });
        navLinks.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            navLinks.classList.remove('is-open');
            toggle.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-logo">Top Notch Inc.</div>
        <p class="footer-tagline">{isJa ? '国際ビジネスアドバイザリー' : 'International Business Advisory'}</p>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Top Notch Inc. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-img {
    height: 44px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    display: block;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 1.8rem;
    align-items: center;
  }

  .nav-links li {
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }

  .nav-toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .nav-toggle.is-open .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle.is-open .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-links a {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .nav-links a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .btn-nav {
    background: var(--color-primary);
    color: #fff !important;
    padding: 0.45rem 1.2rem;
    border-radius: 6px;
    font-size: 0.85rem !important;
  }

  .btn-nav:hover {
    background: #1e293b;
  }

  .lang-switch {
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    font-size: 0.8rem !important;
    color: var(--color-text-light) !important;
    font-weight: 600 !important;
    letter-spacing: 0.05em;
  }

  .lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent) !important;
  }

  .footer {
    background: var(--color-bg-dark);
    color: #9ca3af;
    padding: 3rem 0;
    text-align: center;
  }

  .footer-logo {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  .footer-tagline {
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: #6b7280;
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #ffffff;
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      padding: 0.5rem 1.5rem 1.2rem;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: max-height 0.25s ease, opacity 0.2s ease, padding 0.25s ease;
    }

    .nav-links.is-open {
      max-height: calc(100vh - 70px);
      opacity: 1;
      pointer-events: auto;
    }

    .nav-links li {
      width: 100%;
      border-bottom: 1px solid var(--color-border);
    }

    .nav-links li:last-child {
      border-bottom: 0;
    }

    .nav-links a {
      display: block;
      font-size: 0.95rem;
      padding: 1rem 0.2rem;
    }

    .nav-links .btn-nav,
    .nav-links .lang-switch {
      display: inline-block;
      margin-top: 0.6rem;
      padding: 0.55rem 1.2rem;
      font-size: 0.85rem !important;
    }

    .nav-links li:has(.btn-nav),
    .nav-links li:has(.lang-switch) {
      border-bottom: 0;
    }

    .logo-img {
      height: 36px;
      max-width: 170px;
    }
  }
</style>

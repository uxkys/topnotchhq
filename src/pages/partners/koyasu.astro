<PartnerLayout
  title="Munenori Koyasu"
  description="Web Director / Partner. Delivering the value of companies and works to society through web-based branding strategy and meticulous direction."
  lang="en"
  name="Munenori Koyasu"
  role="Web Director / Partner"

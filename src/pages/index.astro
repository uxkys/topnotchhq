---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home"
  description="Top Notch Inc. — Advisory firm specializing in international business development and brand strategy across European and Asian markets."
  lang="en"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="hero-label">International Business Advisory</p>
      <h1>We read the market, design the strategy,<br />build partnerships, and execute the business.</h1>
      <p class="hero-sub">
        We compress time and risk in global expansion<br />
        and lower the barriers to entering the Japanese market.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn-primary">Get in Touch</a>
        <a href="#about" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container about-grid">
      <div class="about-content">
        <h2 class="section-label">About Us</h2>
        <h3 class="section-heading">Practical expertise in international business</h3>
        <p>
          Top Notch Inc. is an advisory firm specializing in international business
          development and brand strategy. With extensive experience in supporting
          European brands entering Japan, assisting Japanese companies in overseas
          expansion, and building brands in Asian markets, we provide practical
          and strategic business support.
        </p>
        <p>
          Leveraging hands-on experience and international networks, we help
          companies expand their opportunities beyond borders.
        </p>
      </div>
      <div class="about-image">
        <img src="/images/TopNotchInc_icon.avif" alt="Top Notch Inc." />
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section section-alt">
    <div class="container">
      <h2 class="section-label center">Services</h2>
      <h3 class="section-heading center">What We Offer</h3>
      <div class="services-grid">
        <a href="/services/market-research" class="service-card">
          <div class="service-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h4>Market Research</h4>
          <p>In-depth analysis of target markets across Asia and Europe to identify opportunities and mitigate risks.</p>
          <span class="service-link">Learn more →</span>
        </a>
        <a href="/services/brand-strategy" class="service-card">
          <div class="service-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h4>Brand Strategy</h4>
          <p>Strategic brand positioning and development tailored for international markets, drawing on decades of luxury and consumer brand experience.</p>
          <span class="service-link">Learn more →</span>
        </a>
        <a href="/services/partner-development" class="service-card">
          <div class="service-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h4>Partner Development</h4>
          <p>Execution-driven partner development based on real-world experience — beyond introductions to building real, sustainable partnerships.</p>
          <span class="service-link">Learn more →</span>
        </a>
        <a href="/services/business-development" class="service-card">
          <div class="service-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h4>Business Development</h4>
          <p>Execution-driven business development that goes beyond strategy — driving actual sales, negotiation, and market validation.</p>
          <span class="service-link">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section id="founder" class="section">
    <div class="container founder-grid">
      <div class="founder-photo">
        <img src="/images/topnotch_babasaki_photo001.avif" alt="Osamu Babasaki" />
      </div>
      <div class="founder-content">
        <h2 class="section-label">Founder</h2>
        <h3 class="section-heading">Osamu Babasaki</h3>
        <p class="founder-title">Founder & CEO ／ International Business & Brand Advisor</p>
        <p>
          A practical advisor bridging Europe and Asia across diplomacy, brand, and trade.
          With hands-on experience across diplomacy, public institutions, private enterprise,
          and the brand business, he provides international business support spanning the
          European and Asian markets.
        </p>
        <ul class="founder-highlights">
          <li>Served at the JGSDF Intelligence School in language education and Japan-U.S. joint training</li>
          <li>Seconded to MOFA, posted as Consul to the Consulate General of Japan in West Berlin for 4 years</li>
          <li>Trade Director and General Manager at Japan exclusive distributors of European luxury brands (Herend, Moser)</li>
          <li>Led overseas business at a trading company, developing new ventures with Toray, Teijin, and Dutch partners</li>
          <li>Took a company public on the TSE Mothers market within 3 years as IPO Department Head (Executive Managing Director)</li>
          <li>International lead at Yumi Katsura International — collections in Paris, Singapore, Bangkok; Paris boutique management</li>
          <li>Founded Top Notch Inc. and launched its brand business (Devon &amp; Drew Japan)</li>
          <li>Invited by Thailand's Ministry of Commerce to deliver a brand strategy lecture in Bangkok</li>
        </ul>
        <a href="/partners/babasaki" class="founder-detail-link">View full profile →</a>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section id="partners" class="section section-alt">
    <div class="container">
      <h2 class="section-label center">Partners</h2>
      <h3 class="section-heading center">The experts behind Top Notch</h3>
      <p class="partners-intro">
        Our partners bring expertise from different industries and regions, forming
        tailored teams to deliver the right advisory for each engagement.
      </p>
      <div class="partners-grid">
        <a href="/partners/koga" class="partner-card">
          <div class="partner-avatar partner-avatar-photo">
            <img src="/images/topnotch_koga_photo001.jpg" alt="Akane Koga" />
          </div>
          <h4>Akane Koga</h4>
          <p class="partner-card-role">Creative Partner</p>
          <p class="partner-card-bio">Paper quilling artist creating expressive, lifelike forms through flow, density, and space.</p>
          <span class="partner-card-link">View profile →</span>
        </a>
        <a href="/partners/koyasu" class="partner-card">
          <div class="partner-avatar partner-avatar-photo">
            <img src="/images/topnotch_koyasu_photo001.jpg" alt="Munenori Koyasu" />
          </div>
          <h4>Munenori Koyasu</h4>
          <p class="partner-card-role">Web Director</p>
          <p class="partner-card-bio">End-to-end direction for websites, online shops, and software — from concept to implementation.</p>
          <span class="partner-card-link">View profile →</span>
        </a>
        <a href="/partners/suzuki" class="partner-card">
          <div class="partner-avatar partner-avatar-photo">
            <img src="/images/topnotch_suzuki_photo001.jpg" alt="Chihiro Suzuki" />
          </div>
          <h4>Chihiro Suzuki</h4>
          <p class="partner-card-role">Brand Partner (Apparel)</p>
          <p class="partner-card-bio">Founder of "Selfeliz" — a family-oriented gift brand designing family relationships and time.</p>
          <span class="partner-card-link">View profile →</span>
        </a>
        <a href="/partners/jackie" class="partner-card">
          <div class="partner-avatar partner-avatar-photo">
            <img src="/images/topnotch_jackie_photo001.jpg" alt="Jackie Yu" />
          </div>
          <h4>Jackie Yu</h4>
          <p class="partner-card-role">Creative Producer</p>
          <p class="partner-card-bio">Hong Kong & Tokyo-based producer creating brand value through music and advertising.</p>
          <span class="partner-card-link">View profile →</span>
        </a>
        <a href="/partners/barry" class="partner-card">
          <div class="partner-avatar"><span>B</span></div>
          <h4>Barry</h4>
          <p class="partner-card-role">Partner</p>
          <p class="partner-card-bio">Profile coming soon</p>
          <span class="partner-card-link">View profile →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section section-dark">
    <div class="container contact-inner">
      <h2 class="section-label center light">Contact</h2>
      <h3 class="section-heading center light">Let's discuss your next move</h3>
      <p class="contact-desc">
        Whether you're exploring new markets or looking to strengthen your international
        brand presence, we'd love to hear from you.
      </p>
      <a href="mailto:o.babasaki@topnotchhq.com" class="btn-primary btn-light">o.babasaki@topnotchhq.com</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: var(--color-primary);
    color: #fff;
    padding: 10rem 0 6rem;
  }

  .hero-inner {
    max-width: 750px;
  }

  .hero-label {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.8;
    margin-bottom: 2.5rem;
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 0.75rem 1.8rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--color-accent-dark);
    text-decoration: none;
  }

  .btn-secondary {
    display: inline-block;
    color: rgba(255, 255, 255, 0.7);
    padding: 0.75rem 1.8rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }

  /* Sections */
  .section {
    padding: 6rem 0;
  }

  .section-alt {
    background: var(--color-bg-light);
  }

  .section-dark {
    background: var(--color-primary);
    color: #fff;
  }

  .section-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: 0.8rem;
  }

  .section-label.light {
    color: rgba(255, 255, 255, 0.5);
  }

  .section-label.center {
    text-align: center;
  }

  .section-heading {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .section-heading.center {
    text-align: center;
  }

  .section-heading.light {
    color: #fff;
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
    align-items: center;
  }

  .about-content p {
    color: var(--color-text-light);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .about-image {
    display: flex;
    justify-content: center;
  }

  .about-image img {
    width: 200px;
    height: 200px;
    object-fit: contain;
  }

  /* Services */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .service-card {
    background: #fff;
    padding: 2rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    transition: box-shadow 0.2s, transform 0.2s;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .service-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    text-decoration: none;
  }

  a.service-card:hover {
    transform: translateY(-2px);
  }

  .service-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .service-icon {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .service-card h4 {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  .service-card p {
    color: var(--color-text-light);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Founder */
  .founder-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .founder-photo img {
    width: 100%;
    border-radius: 12px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .founder-title {
    font-size: 1rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 1.2rem;
  }

  .founder-content p {
    color: var(--color-text-light);
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
  }

  .founder-highlights {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .founder-highlights li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: 0.7rem;
    color: var(--color-text-light);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .founder-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .founder-detail-link {
    display: inline-block;
    margin-top: 1.8rem;
    font-size: 0.9rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Partners */
  .partners-intro {
    text-align: center;
    color: var(--color-text-light);
    max-width: 680px;
    margin: 0 auto 2.5rem;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.5rem;
  }

  .partner-card {
    background: #fff;
    padding: 2rem 1.5rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    text-align: center;
    transition: box-shadow 0.2s, transform 0.2s;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .partner-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .partner-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 auto 1.2rem;
    letter-spacing: 0.02em;
    overflow: hidden;
  }

  .partner-avatar-photo {
    background: var(--color-bg-light);
  }

  .partner-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-card h4 {
    font-size: 1.05rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .partner-card-role {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.8rem;
  }

  .partner-card-bio {
    font-size: 0.85rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 1rem;
    min-height: 2.8em;
  }

  .partner-card-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Contact */
  .contact-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-desc {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 2rem;
    font-size: 1rem;
  }

  .btn-light {
    background: #fff;
    color: var(--color-primary);
  }

  .btn-light:hover {
    background: #f3f4f6;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 8rem 0 4rem;
    }

    .hero h1 {
      font-size: 1.7rem;
    }

    .hero-sub br {
      display: none;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-image {
      order: -1;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .founder-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .founder-photo img {
      max-width: 250px;
    }

    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .partner-card {
      padding: 1.5rem 1rem;
    }

    .partner-avatar {
      width: 72px;
      height: 72px;
      font-size: 1.5rem;
    }

    .section-heading {
      font-size: 1.6rem;
    }
  }
</style>

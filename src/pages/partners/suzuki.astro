<PartnerLayout
  title="Chihiro Suzuki"
  description="Founder of Selfeliz — a family-oriented gift brand. Brand Partner overseeing design, product development, and brand strategy."
  lang="en"
  name="Chihiro Suzuki"
  role="Brand Partner (Apparel) / Selfeliz Founder · Producer · Designer"
